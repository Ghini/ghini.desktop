# syntax=docker/dockerfile:1.4

FROM ubuntu:24.04

ARG USER_ID=1000
ARG GROUP_ID=1000

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV VIRTUAL_ENV=/opt/venv/ghini
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV HOME=/home/ghini
ENV USER=ghini
ENV LOGNAME=ghini
ENV NO_AT_BRIDGE=1
ENV GHINI_MODE=shell
ENV PYTEST_ARGS=

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Some of Ghini's GTK 3 map dependencies live outside Ubuntu main.
RUN sed -i 's/Components: main$/Components: main universe/' /etc/apt/sources.list.d/ubuntu.sources || true

RUN apt-get update && apt-get install -y --no-install-recommends \
    adwaita-icon-theme \
    at-spi2-core \
    build-essential \
    ca-certificates \
    dbus-x11 \
    gdk-pixbuf2.0-bin \
    gettext \
    gir1.2-champlain-0.12 \
    gir1.2-gdkpixbuf-2.0 \
    gir1.2-gtk-3.0 \
    gir1.2-gtkchamplain-0.12 \
    gir1.2-gtkclutter-1.0 \
    gir1.2-pango-1.0 \
    git \
    glade \
    gobject-introspection \
    hicolor-icon-theme \
    krb5-user \
    libcairo2 \
    libcairo2-dev \
    libcanberra-gtk3-module \
    libffi-dev \
    libgirepository1.0-dev \
    libgtk-3-dev \
    libjpeg-dev \
    libkrb5-dev \
    libpq-dev \
    librsvg2-common \
    libxslt1-dev \
    mesa-utils \
    net-tools \
    openssh-client \
    pkg-config \
    postgresql-client \
    procps \
    python3 \
    python3-cairo \
    python3-dev \
    python3-dogtail \
    python3-gi \
    python3-pyatspi \
    python3-pip \
    python3-venv \
    shared-mime-info \
    vim \
    x11-apps \
    xauth \
    xdg-utils \
    xvfb \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

RUN existing_group="$(getent group "${GROUP_ID}" | cut -d: -f1 || true)" \
    && if [[ -z "${existing_group}" ]]; then \
        groupadd --gid "${GROUP_ID}" ghini; \
    elif [[ "${existing_group}" != "ghini" ]] && ! getent group ghini >/dev/null; then \
        groupmod --new-name ghini "${existing_group}"; \
    fi \
    && existing_user="$(getent passwd "${USER_ID}" | cut -d: -f1 || true)" \
    && if [[ -z "${existing_user}" ]]; then \
        useradd --uid "${USER_ID}" --gid "${GROUP_ID}" --create-home --shell /bin/bash ghini; \
    elif [[ "${existing_user}" != "ghini" ]] && ! id ghini >/dev/null 2>&1; then \
        usermod --login ghini --home /home/ghini --move-home --shell /bin/bash "${existing_user}"; \
        usermod --gid "${GROUP_ID}" ghini; \
    fi \
    && mkdir -p "${HOME}" \
    && chown -R "${USER_ID}:${GROUP_ID}" "${HOME}"

WORKDIR /app

COPY requirements/bootstrap.lock requirements/base.lock requirements/dev.lock /tmp/ghini-build/

# Use system PyGObject from apt. Building PyGObject from pip is fragile for a
# GTK/GI desktop container and duplicates the distro GI stack.
RUN python3 -m venv --system-site-packages "${VIRTUAL_ENV}" \
    && python -m pip install --no-cache-dir -r /tmp/ghini-build/bootstrap.lock

RUN python -m pip install --no-cache-dir \
    -r /tmp/ghini-build/base.lock \
    -r /tmp/ghini-build/dev.lock \
    && chown -R ghini:ghini "${VIRTUAL_ENV}" "${HOME}"

RUN cat > /usr/local/bin/ghini-dev-entrypoint <<'EOS' \
    && chmod +x /usr/local/bin/ghini-dev-entrypoint
#!/usr/bin/env bash
set -euo pipefail

cd /app
export PYTHONPATH=/app

if [[ "${1:-}" == "__ghini_mode__" ]]; then
    shift
elif [[ "$#" -gt 0 ]]; then
    exec "$@"
fi

case "${GHINI_MODE:-shell}" in
    app)
        exec python /app/scripts/ghini "$@"
        ;;
    debug)
        exec python -m debugpy --wait-for-client --listen 0.0.0.0:5678 /app/scripts/ghini "$@"
        ;;
    pytest)
        # shellcheck disable=SC2086
        exec python -m pytest ${PYTEST_ARGS:-} "$@"
        ;;
    pytest-debug)
        # shellcheck disable=SC2086
        exec python -m debugpy --wait-for-client --listen 0.0.0.0:5678 -m pytest ${PYTEST_ARGS:-} "$@"
        ;;
    shell)
        exec bash "$@"
        ;;
    *)
        exec "$@"
        ;;
esac
EOS

EXPOSE 5678

USER ghini

ENTRYPOINT ["/usr/local/bin/ghini-dev-entrypoint"]
CMD ["__ghini_mode__"]
