# Ghini Docker runtime settings.
# Copy this to .env locally and fill in values that match your environment.

GHINI_IMAGE=ghini-desktop-dev:latest
GHINI_CONTAINER=ghini-dev
GHINI_CONFIG_DIR="${HOME}/.bauble/3.1"
GHINI_KRB5_DIR="${HOME}/krb5"
# Optional libpq password file mounted read-only into the Docker container.
# GHINI_PGPASSFILE="${HOME}/.pgpass"
GHINI_XHOST=1
# Optional. Defaults to the host timezone detected by scripts/docker-dev.
# GHINI_TZ=America/New_York
# Optional. When enabled, scripts/docker-dev resolves saved PostgreSQL
# connection hosts, DB_HOST, and PostgreSQL URI hostnames on the host and
# passes matching --add-host entries to Docker.
# Set to 0 if you want Docker DNS/networking to handle all names itself.
# GHINI_DOCKER_AUTO_ADD_HOSTS=1
# Optional comma-separated Docker host mappings for private DNS names.
# GHINI_DOCKER_ADD_HOSTS=postgres.example.net:192.0.2.10,postgres:192.0.2.10
# Optional Docker network mode for specialized test lanes.
# GHINI_DOCKER_NETWORK=container:ghini-postgres-check

DEBUG=false
GHINI_MODE=app

DISPLAY=:0
NO_AT_BRIDGE=1

DB_HOST=postgres.example.net
DB_PORT=5432
DB_NAME=ghini_database
DB_USER=ghini
# Optional. Leave unset when using passwordless, Kerberos, or peer auth.
# DB_PASSWORD=change-me
DB_SSLMODE=prefer

KRB5_CONFIG=/krb5/krb5.conf
KRB5_CLIENT_KTNAME=/krb5/krb5.keytab

PYTEST_ARGS="--maxfail=1 -s -v"

# Optional disposable PostgreSQL lane settings.
# These are used by scripts/docker-dev postgres-check, not by normal app runs.
# GHINI_POSTGRES_IMAGE=postgres:16-alpine
# GHINI_POSTGRES_USER=ghini
# GHINI_POSTGRES_PASSWORD=ghini
# GHINI_POSTGRES_DB=ghini_test

# Optional representative PostgreSQL release-smoke settings.
# GHINI_SOURCE_POSTGRES_URI is read by scripts/docker-dev postgres-copy-smoke.
# Prefer a read-only source role. The source database is dumped, restored into
# a disposable local PostgreSQL container, and then tested through
# GHINI_EXTERNAL_POSTGRES_URI inside the helper command.
# GHINI_SOURCE_POSTGRES_URI=postgresql://readonly_user:secret@postgres.example.net/ghini
# GHINI_POSTGRES_COPY_DUMP=test-results/postgres-smoke/representative.dump
